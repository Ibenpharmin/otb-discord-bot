# Copy to .env and fill in your bot token.
# NEVER commit .env — it is gitignored. The token lives ONLY in the env var.
DISCORD_TOKEN=your-bot-token-here

# Set to false to keep the bot out of voice entirely (radio off).
OTB_RADIO_ENABLED=true

# --- Floor alerts (OpenSea, free tier) ---
# Read-only public market data. Get a free key at the OpenSea developer
# portal. Without a key the bot still runs — floor features stay idle.
OPENSEA_API_KEY=
# Where floor alerts post: a channel ID wins if set; otherwise the bot
# falls back to a channel with this name.
FLOOR_ALERTS_CHANNEL_ID=
FLOOR_ALERTS_CHANNEL_NAME=floor-alerts
# Poll interval in minutes (clamped to 15-30) and alert thresholds (%).
FLOOR_POLL_MINUTES=20
FLOOR_MOVE_THRESHOLD_PCT=10
FLOOR_BELOW_THRESHOLD_PCT=5

# --- Mint alerts (OpenSea + Robinhood Chain public RPC) ---
# Read-only public data on both routes: OpenSea events (reuses the
# OPENSEA_API_KEY above — no new key, no new cost) and the Robinhood
# Chain public RPC (no key at all). No signing, no transactions — ever.
# Without a key the bot still runs — the OpenSea route stays idle and
# the RPC route keeps watching contracts that have one set in mints.json.
# Where mint alerts post: a channel ID wins if set; otherwise the bot
# falls back to a channel with this name.
MINT_ALERTS_CHANNEL_ID=
MINT_ALERTS_CHANNEL_NAME=mint-alerts
# One loop, two cadences: MINT_POLL_MINUTES is the tick (clamped to 1-5;
# the RPC route runs every tick) and the OpenSea route runs every
# MINT_OPENSEA_EVERY-th tick (clamped to 1-10; default 2 = every 2 min).
MINT_POLL_MINUTES=1
MINT_OPENSEA_EVERY=2
# Robinhood Chain mainnet RPC (chain ID 4663). Leave blank for the free
# public endpoint (https://rpc.mainnet.chain.robinhood.com — rate-limited;
# fine for one small poll a minute). Set a provider URL here if the
# public endpoint ever throttles the bot.
ROBINHOOD_CHAIN_RPC_URL=
